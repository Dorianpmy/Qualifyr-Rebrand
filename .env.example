# =============================================================================
# Qualifyr — variables d'environnement
#
# Copiez ce fichier en `.env.local` et renseignez les valeurs. **Aucune valeur
# réelle ne doit jamais figurer ici** : ce fichier est suivi par git.
#
# Colonne « Dév » / « Prod » : O = obligatoire, - = facultatif.
# Le comportement en cas d'absence est décrit sous chaque variable : c'est la
# partie qui compte, parce qu'aucune de ces absences ne provoque d'erreur
# bruyante — elles se manifestent par une fonctionnalité qui ne marche pas.
#
# `src/lib/env-check.ts` recense les obligatoires et permet de les vérifier
# avant un déploiement (`npm run check:env`).
# =============================================================================


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Dév - | Prod O — URL publique canonique, utilisée par les métadonnées, le
# sitemap et les liens des e-mails.
# Absente : repli sur le domaine de production codé en dur ; les liens des
# e-mails de relance peuvent pointer vers le mauvais environnement.
NEXT_PUBLIC_SITE_URL=

# Dév - | Prod O — « true » autorise l'indexation par les moteurs.
# Absente : le site se déclare non indexable. Sans effet en dév.
NEXT_PUBLIC_SITE_INDEXABLE=

# Dév - | Prod - — Jeton de vérification Google Search Console.
# Absente : la balise de vérification n'est pas émise.
GOOGLE_SITE_VERIFICATION=


# -----------------------------------------------------------------------------
# Supabase — base de données et authentification
# -----------------------------------------------------------------------------

# Dév O | Prod O — URL du projet Supabase.
# Absente : aucune connexion, aucune session, l'espace pro est inutilisable.
NEXT_PUBLIC_SUPABASE_URL=

# Dév O | Prod O — Clé publique (anon).
# Absente : idem — la connexion par lien magique échoue silencieusement.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dév O | Prod O — Clé de service. **Serveur uniquement, jamais exposée.**
# Absente : le webhook Stripe ne peut rien écrire, et `getEntitlement` renvoie
# `null` — donc **tous les droits sont refusés**, y compris aux abonnés
# légitimes. C'est le mode de panne le plus trompeur de la liste : l'espace pro
# se comporte comme si personne n'avait payé.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Stripe — abonnements Qualifyr (compte direct)
# -----------------------------------------------------------------------------

# Dév - | Prod O — Clé secrète. `sk_test_…` en test, `sk_live_…` en production.
# Absente : toute création de session d'abonnement lève une erreur explicite.
STRIPE_SECRET_KEY=

# Dév - | Prod O — Secret de signature du webhook des abonnements.
# Absente : `/api/billing/webhook` répond 503. Conséquence : un client paie,
# Stripe encaisse, **et aucun droit n'est jamais accordé**.
STRIPE_BILLING_WEBHOOK_SECRET=

# Dév - | Prod O (les six) — Identifiants de Price Stripe, un par offre et par
# périodicité. Ils servent aussi de repli pour reconnaître le plan quand les
# métadonnées manquent (`planByPriceIdFromEnv`).
# Absente : erreur explicite au clic sur « S'abonner » pour l'offre concernée.
STRIPE_PRICE_AGENT_MONTHLY=
STRIPE_PRICE_AGENT_ANNUAL=
STRIPE_PRICE_SYSTEME_MONTHLY=
STRIPE_PRICE_SYSTEME_ANNUAL=
STRIPE_PRICE_COMPLET_MONTHLY=
STRIPE_PRICE_COMPLET_ANNUAL=


# -----------------------------------------------------------------------------
# Stripe Connect — acomptes encaissés par les professionnels
# -----------------------------------------------------------------------------

# Dév - | Prod O — Secret de signature du webhook des acomptes clients.
# **Distinct de STRIPE_BILLING_WEBHOOK_SECRET** : deux points d'entrée, deux
# secrets. Absente : les acomptes payés ne sont jamais confirmés, les
# réservations restent en attente de paiement indéfiniment.
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Tâches planifiées
# -----------------------------------------------------------------------------

# Dév - | Prod O — Secret partagé entre le planificateur et les routes
# `/api/agent/process`, `/api/detailing/booking-recovery`,
# `/api/detailing/review-dispatch`.
# Absente : les fonctions planifiées s'arrêtent avant d'appeler quoi que ce
# soit. Aucune analyse de zone, aucune relance, aucune demande d'avis.
CRON_SECRET=


# -----------------------------------------------------------------------------
# Services externes
# -----------------------------------------------------------------------------

# Dév - | Prod O — Clé de l'API Sirene de l'INSEE.
# Absente : aucune analyse de secteur n'aboutit ; les zones restent en attente.
INSEE_API_KEY=

# Dév - | Prod O — Clé de l'API Google Places (New), pour le recensement hors
# de France. Sirene est le répertoire des entreprises françaises et s'arrête à
# la frontière ; la Suisse passe par Places (`lib/agent/google-places.ts`).
# Activer « Places API (New) » dans Google Cloud, puis restreindre la clé à
# cette seule API — une clé sans restriction est utilisable par quiconque la
# trouve, et elle est facturée sur votre compte.
# Coût : 5 000 recherches offertes par mois, puis 32 $ les mille. Ne jamais
# ajouter de champ « avis », « photos » ou « horaires » au masque : ils font
# basculer l'appel dans un palier à 40 $.
# Absente : la France continue de fonctionner, la Suisse redevient non couverte.
GOOGLE_PLACES_API_KEY=

# Dév - | Prod O — Clé Resend, pour l'envoi des e-mails.
# Absente : l'analyse va au bout et la zone passe à « terminé », mais **aucun
# rapport n'est envoyé** (`reportSent: false`). Le professionnel ne reçoit
# rien, sans qu'aucune erreur ne soit visible.
RESEND_API_KEY=

# Dév - | Prod O — Secret de signature des webhooks Resend (en-tête
# `svix-signature`), déclaré sur l'endpoint `/api/agent/outreach/webhook`
# depuis le tableau de bord Resend. Traite `email.bounced` et
# `email.complained` pour Hermès.
# Absente : la route refuse tout événement (503) ; aucun rebond ni aucune
# plainte n'alimente `hermes_suppressions`, et une adresse invalide n'est
# retirée que si l'erreur d'envoi synchrone la laisse deviner.
RESEND_WEBHOOK_SECRET=

# Dév - | Prod O — Expéditeur des e-mails.
# Absente : repli sur un domaine de test Resend, qui finit en indésirables.
BOOKING_FROM_EMAIL=

# Dév - | Prod - — WhatsApp Business. Le bouton de contact fonctionne sans.
# Absente : aucun message WhatsApp automatique n'est envoyé.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NEXT_PUBLIC_QUALIFYR_WHATSAPP_NUMBER=

# Dév - | Prod - — URL du tunnel de réservation de démonstration.
NEXT_PUBLIC_QUALIFYR_BOOKING_URL=

# Dév - | Prod - — Mistral, pour le classement des prospects Hermès par
# pertinence (`/api/agent/relevance`). Facultatif : un professionnel qui n'a
# pas décrit son activité n'est pas concerné.
# Absente : le classement par pertinence ne s'applique pas, la file reste
# dans son ordre d'origine.
MISTRAL_API_KEY=
