# =============================================================================
# Qualifyr Agence — variables d'environnement
#
# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# `.env.local` est ignoré par Git : AUCUN SECRET NE DOIT ÊTRE COMMITÉ.
# En production, ces variables se déclarent dans l'hébergeur (Vercel), pas
# dans le dépôt.
# =============================================================================

# --- Envoi des formulaires ---------------------------------------------------
# Les trois variables ci-dessous sont nécessaires ENSEMBLE.
# Si l'une manque :
#   - en développement, l'e-mail est écrit dans la console du serveur ;
#   - en production, le formulaire répond honnêtement qu'il ne peut pas envoyer,
#     et ne prétend jamais que le message est parti.

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Adresse qui reçoit les demandes (boîte de Qualifyr).
CONTACT_TO_EMAIL=

# Adresse d'expédition. Le domaine doit être vérifié chez Resend.
# Exemple : Qualifyr Agence <bonjour@qualifyragence.com>
CONTACT_FROM_EMAIL=

# --- Site --------------------------------------------------------------------
# URL publique, utilisée pour les liens absolus dans les e-mails.
# Repli automatique : https://qualifyragence.com
NEXT_PUBLIC_SITE_URL=
