# =============================================================================
# Qualifyr Agence — variables d'environnement
#
# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# `.env.local` est ignoré par Git : AUCUN SECRET NE DOIT ÊTRE COMMITÉ.
# En production, ces variables se déclarent dans l'hébergeur (Netlify), pas
# dans le dépôt.
# =============================================================================

# --- Envoi des formulaires ---------------------------------------------------
# Les trois variables ci-dessous sont nécessaires ENSEMBLE.
# Si l'une manque :
#   - en développement, l'e-mail est écrit dans la console du serveur ;
#   - en production, le formulaire répond honnêtement qu'il ne peut pas envoyer,
#     et ne prétend jamais que le message est parti.

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Adresse qui reçoit les demandes (boîte de Qualifyr).
CONTACT_TO_EMAIL=

# Adresse d'expédition. Le domaine doit être vérifié chez Resend.
# Exemple : Qualifyr Agence <bonjour@qualifyragence.com>
CONTACT_FROM_EMAIL=

# --- Site --------------------------------------------------------------------
# URL publique, utilisée pour les liens absolus dans les e-mails.
# Repli automatique : https://qualifyragence.com
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_INDEXABLE=

# Code de validation Google Search Console. Laisser vide tant qu'aucun code
# officiel n'a été fourni ; aucune balise vide n'est alors rendue.
GOOGLE_SITE_VERIFICATION=

# URL HTTPS du calendrier commercial Qualifyr. Sans valeur, les boutons
# « Réserver un échange » redirigent vers la page Contact.
NEXT_PUBLIC_QUALIFYR_BOOKING_URL=

# Numéro WhatsApp Qualifyr au format international, chiffres uniquement.
# Sans valeur, le diagnostic affiche le résumé et des alternatives de contact.
NEXT_PUBLIC_QUALIFYR_WHATSAPP_NUMBER=

# --- Produit detailing automobile (docs/13-saas-nettoyage-automobile.md) ----
# URL et clé publique (anon) du projet Supabase. Utilisées côté serveur pour
# lire la configuration d'un professionnel publié, et côté navigateur pour le
# dépôt des photos avant paiement.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service Supabase. Ne jamais exposer au navigateur : elle contourne
# les policies RLS. Utilisée uniquement dans les routes API serveur pour créer
# une réservation (contrainte d'exclusion, recalcul du devis).
SUPABASE_SERVICE_ROLE_KEY=

# --- Paiement des acomptes (Stripe Connect) ----------------------------------
# Sans ces variables, le tunnel enregistre la réservation mais n'encaisse rien :
# le client est prévenu qu'il réglera sur place. Le site ne prétend jamais avoir
# encaissé un acompte qui ne l'a pas été.

# Clé secrète — https://dashboard.stripe.com/apikeys
# Commence par sk_test_ en développement, sk_live_ en production.
STRIPE_SECRET_KEY=

# Secret de signature du webhook — https://dashboard.stripe.com/webhooks
# À créer sur l'endpoint /api/detailing/stripe-webhook, événement
# `checkout.session.completed`, en cochant « Écouter les événements des comptes
# connectés » : sans cette case, aucun paiement ne remonte.
# Commence par whsec_.
STRIPE_WEBHOOK_SECRET=

# --- Messages WhatsApp -------------------------------------------------------
# API Cloud de Meta. Deux modèles doivent être créés ET approuvés avant le
# premier envoi : `vehicule_pret` et `demande_avis` (voir src/lib/detailing/
# whatsapp.ts pour leur texte exact). Compter quelques jours de validation.

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Déclencheur des tâches planifiées ---------------------------------------
# Protège /api/detailing/review-dispatch. Sans ce secret, la route refuse tout
# appel — n'importe qui pourrait sinon faire partir des messages en boucle.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# --- Agent d'acquisition (analyse de secteur) --------------------------------
# Clé de l'API Sirene de l'INSEE. Gratuite, à créer sur
# https://portail-api.insee.fr/ — souscrire à « API Sirene », puis copier la
# clé d'intégration. Quota : 30 requêtes par minute.
#
# Sans elle, /api/agent/scan enregistre les demandes mais /api/agent/process
# échoue : les zones restent en attente et aucun rapport ne part.
INSEE_API_KEY=

# Le planificateur appelle /api/agent/process toutes les 15 minutes, avec
# l'en-tête `Authorization: Bearer $CRON_SECRET`. Une zone traitée par passage.
